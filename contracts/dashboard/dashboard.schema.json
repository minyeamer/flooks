{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://flooks.io/schema/dashboard-v1alpha1.json",
  "type": "object",
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "flooks.io/v1alpha1"},
    "kind": {"const": "Dashboard"},
    "metadata": {"type": "object", "required": ["name", "title"], "properties": {"name": {"type": "string"}, "title": {"type": "string"}}},
    "spec": {
      "type": "object",
      "required": ["columns", "filters", "placements"],
      "properties": {
        "columns": {"const": 12},
        "filters": {"type": "array", "items": {"enum": ["date", "platform_name", "team_name", "brand_name"]}},
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "chartId", "chartRevision", "x", "y", "w", "h"],
            "properties": {
              "id": {"type": "string", "minLength": 1},
              "chartId": {"type": "string"},
              "chartRevision": {"type": "integer", "minimum": 1},
              "x": {"type": "integer", "minimum": 0},
              "y": {"type": "integer", "minimum": 0},
              "w": {"type": "integer", "minimum": 1, "maximum": 12},
              "h": {"type": "integer", "minimum": 1}
            }
          }
        }
      }
    }
  }
}
